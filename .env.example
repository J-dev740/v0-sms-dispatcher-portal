# SMS Gateway Portal Environment Variables

# ============================================
# FRONTEND (.env.local for Next.js)
# ============================================

# API base URL for SMS sending backend
# Local development: http://localhost:3001
# Production: https://your-backend-domain.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# ============================================
# BACKEND (.env for Express server)
# ============================================

# Server configuration
NODE_ENV=development
PORT=3001

# CORS: Allow requests from frontend URL
# Local development: http://localhost:3000
# Production: https://your-frontend-domain.com
CORS_ORIGIN=http://localhost:3000

# Twilio Configuration
# Get these from https://console.twilio.com
# Steps:
# 1. Sign up for Twilio at https://www.twilio.com
# 2. Verify your phone number or use trial credits
# 3. Go to Account > API keys & tokens
# 4. Copy Account SID and Auth Token
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio Phone Number for sending SMS
# Example: +1234567890 (E.164 format)
# This is your Twilio number that will be used as default sender
TWILIO_PHONE_NUMBER=+1234567890
