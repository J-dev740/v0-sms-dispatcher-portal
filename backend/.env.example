# SMS Gateway Backend - Environment Variables

# Server Configuration
NODE_ENV=development
PORT=3001

# CORS Configuration
# Set to your frontend URL
# Local: http://localhost:3000
# Production: https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:3000

# Twilio Configuration
# Get from: https://console.twilio.com
# 1. Account > API keys & tokens
# 2. Copy Account SID and Auth Token
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Twilio Phone Number (E.164 format)
# Your number from Twilio
# Example: +1234567890
TWILIO_PHONE_NUMBER=
